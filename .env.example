# ==============================================================================
# Archivalia — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to Git. Only .env.example (this file) is committed.
# ==============================================================================

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=archivalia
MYSQL_PASSWORD=changeme

# ── JWT (needed from Phase 2 onwards) ────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters-long

# ── Razorpay Sandbox (needed from Phase 5 onwards) ──────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
