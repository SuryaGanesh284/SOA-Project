    {
      "name": "3. User Profile (Protected)",
      "item": [
        {
          "name": "Get Current Profile (requires Bearer token)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/users/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "users", "me"]
            }
          }
        }
      ]
    },
    {
